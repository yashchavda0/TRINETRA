# Environment for the Kafka container in docker-compose.infra.yml.
#
# Tracked in git on purpose: single-node broker topology for local development,
# no credentials. Anything secret belongs in a gitignored file instead.

# Single-node KRaft: broker and controller in one process. No ZooKeeper.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller

# Must not change once the kafka-data volume is initialised - the broker refuses
# to start against log dirs stamped with a different cluster id. Wipe the volume
# (`down -v`) if you need a new one.
CLUSTER_ID=trinetra-local-cluster-01

KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
# 127.0.0.1, not localhost: the port published by compose is IPv4-only, while
# "localhost" resolves to ::1 first on Windows. Advertising the hostname makes
# every client burn its connect timeout on IPv6 before falling back, which
# silently drops messages whose flush deadline expires first.
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://127.0.0.1:9092
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# Single broker: every replication factor must be 1 or topic creation hangs.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# surveillance-events-raw is created on first produce. Turn this off and create
# topics explicitly before running this in a shared environment.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

KAFKA_LOG_DIRS=/var/lib/kafka/data
TZ=UTC
