# Environment for the PostgreSQL/PostGIS container in docker-compose.infra.yml.
#
# Copy this file before the first `docker compose up -d`:
#   Copy-Item docker/postgres.env.example docker/postgres.env
#
# docker/postgres.env is gitignored, so the real password never enters version
# control. Compose fails with "env file not found" if the copy is missing.
#
# IMPORTANT: DATABASE_URL in .env must stay in sync with all three values below:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>
#
# These are only read when the postgres-data volume is initialised. Changing a
# password later has no effect on an existing volume - either ALTER the role by
# hand or `docker compose -f docker-compose.infra.yml down -v` first.

POSTGRES_USER=trinetra
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=trinetra

# Keeps server-side timestamps in UTC, matching the invariant the schema and the
# protobuf contract both assume.
TZ=UTC
PGTZ=UTC
