# Multi-stage slim Docker build for stream_relay
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum* ./
RUN go mod download

# Copy source code and build statically stripped pure-Go binary
COPY . .
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/stream_relay ./cmd/stream_relay

# Minimal runtime image with ffmpeg for media transcoding
FROM alpine:3.20
RUN apk add --no-cache ca-certificates ffmpeg tzdata

COPY --from=builder /bin/stream_relay /usr/local/bin/stream_relay

EXPOSE 9443
ENTRYPOINT ["/usr/local/bin/stream_relay"]
