# Console configuration. Copy to frontend/.env - Vite only exposes variables
# with the VITE_ prefix, and everything exposed is compiled into the bundle and
# readable by anyone who can open the page. Development values only.

# Must match P0_ALERT_API_KEY in the repository-root .env. A browser cannot set
# headers on a WebSocket, so the console presents this as ?token= on
# /alerts/p0. Leave empty only if P0_ALERT_API_KEY is also empty; otherwise the
# API closes the handshake and the alert badge reads "unauthorised".
VITE_P0_ALERT_TOKEN=local-dev-alert-key

# Where the dev server proxies /api, /alerts and /health. Defaults to
# http://127.0.0.1:8000 - set this when the registry API runs elsewhere.
# VITE_API_TARGET=http://127.0.0.1:8000
