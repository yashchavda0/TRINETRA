# TRINETRA local development configuration.
# Copy to .env (which is gitignored) and adjust:
#   Copy-Item .env.example .env
#
# Everything below matches docker-compose.infra.yml, so the defaults work as-is
# for the hybrid setup: database and Kafka in containers, Python and the console
# native on the host.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Model 1 - Central GIS Camera Registry
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://trinetra:trinetra@127.0.0.1:5432/trinetra
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_COMMAND_TIMEOUT=30

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated. The Vite dev server proxies the API, so its origin is what
# the browser actually talks to.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_SPATIAL_RESULTS=500
MAX_LIST_RESULTS=10000
MAX_HEALTH_PING_BATCH=5000

# ---------------------------------------------------------------------------
# Authentication (Model 1 RBAC)
# ---------------------------------------------------------------------------
# MUST be changed for any deployment. Every access token is signed with this,
# so anyone holding it can mint an administrator session. The API logs a
# warning at startup while the built-in development value is still in use.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

# First-run bootstrap. POST /api/v1/users/bootstrap creates the first
# SUPER_ADMIN from these values and refuses once any user exists. Clear them
# once that account is created and its password has been changed.
BOOTSTRAP_ADMIN_EMAIL=admin@trinetra.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately

# ---------------------------------------------------------------------------
# Analytics bus
# ---------------------------------------------------------------------------
# Must match cmd/ingestion_gateway, which hardcodes the topic name.
# Use 127.0.0.1, not localhost: Windows resolves localhost to ::1 first and the
# broker's published port is IPv4-only, so clients stall on IPv6 and can drop
# messages whose flush deadline expires during the fallback.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RAW=surveillance-events-raw
KAFKA_CONSUMER_GROUP=trinetra-handoff-worker
KAFKA_POLL_TIMEOUT_SECONDS=1.0

# ---------------------------------------------------------------------------
# Model 4 engine
# ---------------------------------------------------------------------------
# Leave ENGINE_DEVICE empty to auto-select: CUDA when present, else CPU.
ENGINE_DEVICE=
SIMILARITY_THRESHOLD=0.85
HANDOFF_PROBABILITY_THRESHOLD=0.65
COOLDOWN_SECONDS=60
PRE_ACTIVATION_TIMEOUT_SECONDS=30
EDGE_DISTANCE_THRESHOLD_M=1500
MAX_ACTIVE_TARGETS=4096
TARGET_TTL_SECONDS=300
SCHEDULER_INTERVAL_SECONDS=1.0
GRAPH_RELOAD_SECONDS=300

# ---------------------------------------------------------------------------
# External state registries
# ---------------------------------------------------------------------------
# Leaving a base URL empty puts that adapter into deterministic simulation mode
# instead of failing every lookup, which is what you want locally. Never point
# these at production registries from a development machine.
EGUJCOP_BASE_URL=
EGUJCOP_API_KEY=
VAHAN_BASE_URL=
VAHAN_API_KEY=

# ---------------------------------------------------------------------------
# P0 alert channel
# ---------------------------------------------------------------------------
# This service's own fan-out socket, not the external central-command host.
P0_ALERT_WS_URL=ws://127.0.0.1:8000/alerts/p0
ALERT_PUBLISH_URL=http://127.0.0.1:8000/api/v1/alerts/publish
# Shared secret for both the publish endpoint and console subscriptions. Empty
# means the channel is unauthenticated - acceptable only on a local machine.
P0_ALERT_API_KEY=local-dev-alert-key

# ---------------------------------------------------------------------------
# Media plane (MediaMTX)
# ---------------------------------------------------------------------------
# MediaMTX carries the actual video: RTSP in, WebRTC out. The API proxies the
# browser's SDP offer to its WHEP endpoint. This is the default backend - leave
# these set unless you are deliberately testing the legacy Go relay.
MEDIAMTX_WHEP_BASE_URL=http://127.0.0.1:8889
MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997
MEDIAMTX_RTSP_HOST=127.0.0.1:8554
MEDIAMTX_REQUEST_TIMEOUT_SECONDS=10
# Longer budget for bringing an on-demand camera up (dial RTSP, negotiate,
# produce a keyframe). Raise it for cameras on slow links; lower it for faster
# feedback that a camera is dead.
MEDIAMTX_SOURCE_START_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Recording
# ---------------------------------------------------------------------------
# MediaMTX's separate playback server (mediamtx.yml's `playback:` block) -
# not the control API above. Serves clips and segment lists for recorded video.
MEDIAMTX_PLAYBACK_BASE_URL=http://127.0.0.1:9996
# Container-side path; docker-compose.infra.yml bind-mounts data/recordings here.
RECORDINGS_DIR=/recordings
RECORDING_SEGMENT_SECONDS=900
RECORDING_FORMAT=fmp4
# How often every ACTIVE camera's MediaMTX path config is re-asserted
# (source, record, recordDeleteAfter) - so a retention_days edit in the
# Registry takes effect without restarting anything.
RECORDING_RECONCILE_INTERVAL_SECONDS=120
# Spacing between each camera's initial dial when recording first comes up.
# Recording needs every camera connected continuously, not just the one being
# watched - without this spacing that is every camera dialling the external
# grid at once.
RECORDING_STAGGER_SECONDS=2
# Applied when a camera's retention_days is unset, so "no policy set" does not
# silently mean "keep forever".
DEFAULT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# External live-feed grid (evaluation)
# ---------------------------------------------------------------------------
# THESE ARE TEST VALUES. Replace the two hosts when the real grid is issued -
# they are the only place any grid host, port or camera id is written down.
#
# The grid splits its access model in two, because a CDN cannot proxy RTSP or
# WebRTC: the CDN host serves the catalogue and HLS on any network, while RTSP
# and WHEP are served directly on a public static IP, and need the gateway
# ports open (8554/TCP, 8889/TCP, 8189/UDP).
#
# Camera catalogue. The camera set can change, so this is the source of truth
# for which cameras exist - LIVE_GRID_CAMERA_IDS below is only a fallback.
LIVE_GRID_CATALOGUE_URL=https://cctv2.cor8.cloud/cameras.json
# CDN base for HLS: <base>/<id>/index.m3u8. Works on restricted networks and
# is what to register when 8554/TCP is blocked.
LIVE_GRID_HLS_BASE_URL=https://cctv2.cor8.cloud
# Public static IP serving RTSP and WebRTC directly (never via the CDN).
LIVE_GRID_MEDIA_HOST=172.251.160.190
LIVE_GRID_RTSP_PORT=8554
# Registered email and access password. The grid authenticates EVERY RTSP and
# WebRTC connection with these, and only approved emails may connect.
#
# Put the email in plainly - do NOT percent-encode the @ here. The API encodes
# it to %40 when it builds the URL MediaMTX dials with.
#
# These stay in this file only. The registry stores grid URLs without
# credentials, so the password never reaches Postgres and is never returned by
# GET /api/v1/cameras. The API injects it at dial time, which means uvicorn
# must be restarted after you edit these two lines.
LIVE_GRID_EMAIL=
LIVE_GRID_PASSWORD=
# Fallback camera ids, used only when the catalogue cannot be read. Either a
# range whose ends share a prefix (cam01-cam30) or a comma-separated list.
LIVE_GRID_CAMERA_IDS=cam01-cam30

# ---------------------------------------------------------------------------
# Stream relay (cmd/stream_relay) - LEGACY, bypassed by default
# ---------------------------------------------------------------------------
# MediaMTX takes precedence whenever MEDIAMTX_WHEP_BASE_URL is set. Clear that
# variable to fall back to the Go relay, and read the README's known
# limitations first: the relay's media path cannot deliver video.
# Leave STREAM_RELAY_BASE_URL empty until the Go tier is built and running. The
# WebRTC proxy then returns a clear 503 and the rest of the console works.
# When you do run it, uncomment and generate certs with scripts/gen_dev_certs.ps1.
STREAM_RELAY_BASE_URL=
# STREAM_RELAY_BASE_URL=https://127.0.0.1:9443
RELAY_CLIENT_CERT_FILE=certs/api-client.crt
RELAY_CLIENT_KEY_FILE=certs/api-client.key
RELAY_CA_FILE=certs/ca.crt
RELAY_REQUEST_TIMEOUT_SECONDS=10
RELAY_SESSION_KEEPALIVE_SECONDS=10
RELAY_SESSION_MAX_AGE_SECONDS=1800

# ---------------------------------------------------------------------------
# Go services
# ---------------------------------------------------------------------------
# Read directly by the Go binaries, not by pydantic-settings. Export them in the
# shell that launches each binary. All six file paths are mandatory - both
# services exit immediately without them.
INGEST_LISTEN_ADDR=:8443
INGEST_TLS_CERT_FILE=certs/ingest-server.crt
INGEST_TLS_KEY_FILE=certs/ingest-server.key
INGEST_TLS_CA_FILE=certs/ca.crt

STREAM_RELAY_LISTEN_ADDR=:9443
STREAM_RELAY_TLS_CERT_FILE=certs/relay-server.crt
STREAM_RELAY_TLS_KEY_FILE=certs/relay-server.key
STREAM_RELAY_TLS_CA_FILE=certs/ca.crt
# Placeholder by default; a real value must be the fingerprint of the DTLS
# certificate the relay actually presents.
STREAM_DTLS_FINGERPRINT=

# --- VLM agent (services/vlm_agent) --------------------------------------
# "local" loads a GGUF checkpoint in-process via llama-cpp-python (needs
# VLM_AGENT_MODEL_PATH/VLM_AGENT_MMPROJ_PATH to point at real files).
# "hosted" instead calls an OpenAI-compatible /v1/chat/completions endpoint
# over HTTP - no GGUF, no llama-cpp-python needed. Uncomment the three lines
# below to run against a hosted server.
VLM_AGENT_BACKEND=local
# VLM_AGENT_BACKEND=hosted
# VLM_AGENT_HOSTED_API_BASE_URL=http://43.242.38.16:8009/v1
# VLM_AGENT_HOSTED_MODEL_NAME=openai/gpt-oss-20b
# VLM_AGENT_HOSTED_API_KEY=

